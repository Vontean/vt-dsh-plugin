{
  "name": "dsh-vt-interface",
  "version": "2.6.3",
  "private": true,
  "type": "module",
  "description": "dsh-vt-Interface: UI/UX refinements for DeepSeek Harness, shipped as reversible patches over its own tokens, slots and styles. Disabling the plugin restores the shipped interface exactly.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "AGENTS.md",
    "DESIGN.md",
    "docs/*.md",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
