{
  "name": "dsh-vt-web-chat",
  "version": "2.1.0",
  "type": "module",
  "description": "Adds a DeepSeek Chat mode inside DeepSeek Harness: the official open-source chat UI, chat history in the sidebar, and a back-to-Harness switch, with requests proxied through your signed-in account and a configurable local chat-retention policy.",
  "license": "MIT",
  "author": "Vontean",
  "homepage": "https://github.com/Vontean/vt-dsh-plugin/tree/main/plugins/vt-web-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vontean/vt-dsh-plugin.git",
    "directory": "plugins/vt-web-chat"
  },
  "bugs": {
    "url": "https://github.com/Vontean/vt-dsh-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-chat",
    "chat-demo",
    "deepseek",
    "retention",
    "sidebar",
    "chat-mode"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "scripts/",
    "webview/dist/",
    "webview/UPSTREAM.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "dev": "node scripts/dev-server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
