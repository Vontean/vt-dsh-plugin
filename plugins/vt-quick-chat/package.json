{
  "name": "dsh-vt-quick-chat",
  "version": "1.0.0",
  "type": "module",
  "description": "Press a shortcut during an agent task to open a temporary quick-chat overlay that explains concepts with streaming answers, without creating a session, writing the session log, or calling tools.",
  "license": "MIT",
  "author": "Vontean",
  "homepage": "https://github.com/Vontean/vt-dsh-plugin/tree/main/plugins/vt-quick-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vontean/vt-dsh-plugin.git",
    "directory": "plugins/vt-quick-chat"
  },
  "bugs": {
    "url": "https://github.com/Vontean/vt-dsh-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "quick-chat",
    "overlay",
    "explain",
    "concept",
    "shortcut",
    "ephemeral"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
