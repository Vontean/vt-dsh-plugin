{
  "name": "dsh-vt-sidebar-sort",
  "version": "1.0.0",
  "type": "module",
  "description": "Drag the global panel rows under New Session into your own order, and drop one on the More row to file it into the More menu; the drag caret is the same one the session list draws.",
  "license": "MIT",
  "author": "Vontean",
  "homepage": "https://github.com/Vontean/vt-dsh-plugin/tree/main/plugins/vt-sidebar-sort#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vontean/vt-dsh-plugin.git",
    "directory": "plugins/vt-sidebar-sort"
  },
  "bugs": {
    "url": "https://github.com/Vontean/vt-dsh-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "sort",
    "drag",
    "reorder",
    "navigation"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
